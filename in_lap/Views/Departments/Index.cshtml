@model IEnumerable<in_lap.Models.Department>
@{
    ViewData["Title"] = " Departments page";
}﻿



<div class="container">

    <h1>Departments</h1>

    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary"> New Department </a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Action</th>
               
            </tr>
        </thead>
        <tbody>
            @foreach (var emp in Model)
            {

                <tr>
                    <td>@emp.Id</td>
                    <td>@emp.Name</td>
                    <td>
                        <a asp-action="Edit" asp-route-Id="@emp.Id" class="btn btn-warning"> Edit  </a>
                        <a asp-action="Delete" asp-route-Id="@emp.Id"  class="btn btn-danger"> Delete  </a>
                    </td>
                  
                </tr>

            }


        </tbody>

    </table>
</div>