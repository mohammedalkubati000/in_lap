@model IEnumerable<Employee>
@{
    ViewData["Title"] = " Employees page";
}
<div class="container">

    <h1>Employees</h1>

    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary"> New Department </a>
    </div>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Position</th>
                <th>Salary</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var emp in Model)
            {

                <tr>
                    <td>@emp.Id</td>
                    <td>@emp.Name</td>
                    <td>@emp.Position</td>
                    <td>@emp.Salary</td>
                </tr>   

            }


        </tbody>

    </table>
</div>